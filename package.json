{
  "name": "claude-mission-control",
  "version": "0.1.0",
  "description": "Terminal multiplexer for Claude Code — real-time visibility into agents, thinking, tools, and file changes",
  "type": "module",
  "bin": {
    "cmc": "./src/index.ts"
  },
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/headless": "^5.5.0",
    "node-pty": "^1.0.0",
    "chokidar": "^4.0.0",
    "strip-ansi": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
